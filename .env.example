# ── ML / data pipeline ────────────────────────────────────────────────────────
# Directory holding committed pkl caches + FastF1 session data.
# Leave unset to use the repo-local ./data directory (default, warm-start ready).
# Set to a mounted volume path on a cloud host if data must live outside the image.
# F1_DATA_DIR=/data

# FastF1 + pickle cache directory. Defaults to F1_DATA_DIR.
# Only set if the cache must live apart from committed data.
# F1_CACHE_DIR=/var/cache/f1

# ── Backend API ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Defaults to "*" (all).
# In production set to the deployed frontend origin, e.g. https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# Port the API binds to (Render injects this automatically).
# PORT=8000

# ── Frontend (set in Vercel project settings, not this file) ──────────────────
# VITE_API_URL=https://your-api.onrender.com
