# ── Data cache ────────────────────────────────────────────────────────────────
# Ignore everything inside data/ except pre-built pickle caches.
# Pkl files are committed so deployed servers start warm (no cold-download).
data/*
!data/history_*.pkl
!data/quali_*.pkl
!data/practice_*.pkl

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
f1/
*.egg-info/
dist/
build/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend.zip

# ── Tooling / IDE ─────────────────────────────────────────────────────────────
.claude/
.impeccable/
.vscode/
.idea/

# ── Planning docs (not part of the app) ──────────────────────────────────────
F1_Predictor_*.md
PRODUCT.md

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
