# Ignore everything inside data/ except our pre-built pickle caches.
# The pickle files are committed so deployed servers don't need to
# re-download from FastF1 on cold start.
# Post-race update: python warm_cache.py --stage2 → git add data/*.pkl → push
data/*
!data/history_*.pkl
!data/quali_*.pkl
!data/practice_*.pkl

# Output artifacts — never commit these
data/*.csv
data/*.json
data/*.png
data/*.html

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
f1/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
